<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Space Neon Shooter</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            user-select: none;
        }
        body {
            background: #020208;
            color: #fff;
            font-family: 'Segoe UI', sans-serif;
            overflow: hidden;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
        }
        #gameArea {
            position: relative;
            width: 480px;
            height: 640px;
            border: 2px solid #00f2fe;
            box-shadow: 0 0 30px rgba(0, 242, 254, 0.3);
            background: #050515;
            overflow: hidden;
        }
        .ui-container {
            position: absolute;
            top: 20px;
            left: 50%;
            transform: translateX(-50%);
            text-align: center;
            z-index: 10;
        }
        .score {
            font-size: 2rem;
            font-weight: bold;
            color: #00f2fe;
            text-shadow: 0 0 10px rgba(0, 242, 254, 0.8);
        }
        /* Kosmik kema */
        #playerShip {
            position: absolute;
            bottom: 30px;
            left: 220px;
            width: 40px;
            height: 40px;
            background: #00f2fe;
            clip-path: polygon(50% 0%, 0% 100%, 100% 100%);
            box-shadow: 0 0 20px #00f2fe;
            transition: left 0.05s ease-out;
        }
        /* Asteroidlar */
        .asteroid {
            position: absolute;
            width: 30px;
            height: 30px;
            background: #00ff66;
            border-radius: 50%;
            box-shadow: 0 0 15px #00ff66;
        }
        /* Lazerlar */
        .laser {
            position: absolute;
            width: 4px;
            height: 15px;
            background: #ff007f;
            box-shadow: 0 0 10px #ff007f;
        }
        .controls-hint {
            position: absolute;
            bottom: 20px;
            color: rgba(255, 255, 255, 0.5);
            font-size: 0.9rem;
            text-align: center;
            width: 100%;
        }
        .game-over-screen {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(5, 5, 21, 0.95);
            display: none;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            z-index: 20;
            text-align: center;
        }
        .game-over-screen h2 {
            font-size: 3rem;
            color: #ff007f;
            text-shadow: 0 0 15px #ff007f;
            margin-bottom: 20px;
        }
        .restart-btn {
            margin-top: 20px;
            padding: 12px 30px;
            font-size: 1.2rem;
            background: linear-gradient(45deg, #00f2fe, #4facfe);
            border: none;
            color: #000;
            font-weight: bold;
            border-radius: 8px;
            cursor: pointer;
        }
    </style>
</head>
<body>

    <div id="gameArea">
        <div class="ui-container">
            <div class="score" id="scoreDisplay">SCORE: 0</div>
        </div>

        <div id="playerShip"></div>

        <div class="game-over-screen" id="gameOverScreen">
            <h2>GAME OVER</h2>
            <div class="score" id="finalScoreDisplay">SCORE: 0</div>
            <button class="restart-btn" id="restartBtn">Qaytadan boshlash</button>
        </div>
    </div>

    <div class="controls-hint">Boshqarish: Sichqonchani suring (kema ergashadi) va chap tugmani bosing (otish)</div>

    <script>
        const gameArea = document.getElementById('gameArea');
        const playerShip = document.getElementById('playerShip');
        const scoreDisplay = document.getElementById('scoreDisplay');
        const finalScoreDisplay = document.getElementById('finalScoreDisplay');
        const gameOverScreen = document.getElementById('gameOverScreen');
        const restartBtn = document.getElementById('restartBtn');

        let score = 0;
        let isGameOver = false;
        let shipX = 220;
        const shipWidth = 40;
        const areaWidth = 480;

        // Boshqaruv
        gameArea.addEventListener('mousemove', (e) => {
            if (isGameOver) return;
            const rect = gameArea.getBoundingClientRect();
            shipX = e.clientX - rect.left - (shipWidth / 2);
            
            if (shipX < 0) shipX = 0;
            if (shipX > areaWidth - shipWidth) shipX = areaWidth - shipWidth;
            
            playerShip.style.left = shipX + 'px';
        });

        // Otish
        gameArea.addEventListener('click', () => {
            if (isGameOver) return;
            
            const laser = document.createElement('div');
            laser.className = 'laser';
            laser.style.left = (shipX + (shipWidth / 2) - 2) + 'px';
            laser.style.bottom = '70px';
            gameArea.appendChild(laser);

            let laserInterval = setInterval(() => {
                if (isGameOver) {
                    clearInterval(laserInterval);
                    laser.remove();
                    return;
                }
                let currentBottom = parseInt(laser.style.bottom);
                if (currentBottom > 640) {
                    clearInterval(laserInterval);
                    laser.remove();
                } else {
                    laser.style.bottom = (currentBottom + 7) + 'px';
                    checkLaserCollision(laser, laserInterval);
                }
            }, 20);
        });

        // Asteroidlarni tushirish
        let spawnInterval = setInterval(() => {
            if (isGameOver) return;

            const asteroid = document.createElement('div');
            asteroid.className = 'asteroid';
            asteroid.style.left = Math.random() * (areaWidth - 30) + 'px';
            asteroid.style.top = '-30px';
            gameArea.appendChild(asteroid);

            let asteroidInterval = setInterval(() => {
                if (isGameOver) {
                    clearInterval(asteroidInterval);
                    asteroid.remove();
                    return;
                }
                let currentTop = parseInt(asteroid.style.top);
                if (currentTop > 640) {
                    clearInterval(asteroidInterval);
                    asteroid.remove();
                } else {
                    asteroid.style.top = (currentTop + 3) + 'px';
                    checkPlayerCollision(asteroid, asteroidInterval);
                }
            }, 20);

        }, 1200);

        // To'qnashuvlarni tekshirish
        function checkLaserCollision(laser, laserInterval) {
            const asteroids = document.querySelectorAll('.asteroid');
            asteroids.forEach(asteroid => {
                let lRect = laser.getBoundingClientRect();
                let aRect = asteroid.getBoundingClientRect();

                if (!(lRect.right < aRect.left || 
                      lRect.left > aRect.right || 
                      lRect.bottom < aRect.top || 
                      lRect.top > aRect.bottom)) {
                    
                    clearInterval(laserInterval);
                    laser.remove();
                    asteroid.remove();
                    score += 10;
                    scoreDisplay.textContent = "SCORE: " + score;
                }
            });
        }

        function checkPlayerCollision(asteroid, asteroidInterval) {
            let aRect = asteroid.getBoundingClientRect();
            let pRect = playerShip.getBoundingClientRect();

            if (!(aRect.right < pRect.left || 
                  aRect.left > pRect.right || 
                  aRect.bottom < pRect.top || 
                  aRect.top > pRect.bottom)) {
                
                isGameOver = true;
                clearInterval(asteroidInterval);
                finalScoreDisplay.textContent = "SCORE: " + score;
                gameOverScreen.style.display = 'flex';
            }
        }

        // Qaytadan boshlash
        restartBtn.addEventListener('click', () => {
            document.querySelectorAll('.asteroid').forEach(a => a.remove());
            document.querySelectorAll('.laser').forEach(l => l.remove());
            score = 0;
            isGameOver = false;
            scoreDisplay.textContent = "SCORE: 0";
            gameOverScreen.style.display = 'none';
            playerShip.style.left = '220px';
            shipX = 220;
        });
    </script>
</body>
</html>
